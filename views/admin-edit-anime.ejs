<%- include('partials/header') %>

<style>
    /* Global Variables & Base Setup */
    :root {
        --bg-deep: #0b0e11;
        --card-navy: #151b23;
        --input-dark: #1c232d;
        --primary-blue: #3b82f6;
        --text-muted: #9ca3af;
        --danger-red: #ef4444;
        --success-green: #10b981;
    }

    .admin-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 90vh;
        width: 100%;
        padding: 4rem 1.25rem;
    }

    .ui-card {
        background-color: var(--card-navy);
        border: 1px solid rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border-radius: 2.5rem;
        width: 100%;
        max-width: 650px;
        padding: 3.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .ui-label {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
        display: block;
    }

    .ui-input {
        background-color: var(--input-dark);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        color: #ffffff;
        padding: 1.1rem;
        width: 100%;
        transition: all 0.2s ease;
        font-size: 0.95rem;
        box-sizing: border-box;
    }

    .ui-input:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 1px var(--primary-blue);
    }

    .ui-input:disabled,
    .ui-input[readonly] {
        opacity: 0.6;
        cursor: not-allowed;
        background: rgba(28, 35, 45, 0.5);
    }

    .ui-button {
        background-color: var(--primary-blue);
        color: #ffffff;
        font-weight: 800;
        padding: 1.2rem;
        border-radius: 1.25rem;
        width: 100%;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border: none;
        cursor: pointer;
        margin-top: 1rem;
    }

    .ui-button:hover:not(:disabled) {
        transform: translateY(-2px);
        filter: brightness(1.1);
        box-shadow: 0 15px 30px rgba(59, 130, 246, 0.3);
    }

    .ui-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .back-link {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 800;
        text-decoration: none;
        margin-bottom: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .back-link:hover { color: #fff; }

    .form-error {
        color: var(--danger-red);
        font-size: 0.75rem;
        font-weight: 700;
        margin-top: 0.5rem;
        margin-bottom: 1rem;
        display: none;
    }
    .form-error.show { display: block; }

    .genre-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        background: rgba(0,0,0,0.2);
        padding: 1.5rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(255,255,255,0.02);
    }
    .genre-item {
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s;
    }
    .genre-item:hover { color: #fff; }
    input[type="checkbox"] {
        margin-right: 10px;
        accent-color: var(--primary-blue);
        width: 18px;
        height: 18px;
    }

    .type-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .type-option {
        background: var(--input-dark);
        border: 2px solid rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        position: relative;
    }

    .type-option input[type="radio"] {
        position: absolute;
        opacity: 0;
    }

    .type-option:hover {
        border-color: rgba(59, 130, 246, 0.3);
        background: rgba(59, 130, 246, 0.05);
    }

    .type-option.active {
        border-color: var(--primary-blue);
        background: rgba(59, 130, 246, 0.1);
    }

    .type-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .type-label {
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .type-desc {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    .warning-box {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .warning-text {
        font-size: 0.75rem;
        font-weight: 700;
        color: #fca5a5;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    @media (max-width: 640px) {
        .ui-card { padding: 2rem 1.5rem; }
        .type-selector { grid-template-columns: 1fr; }
    }
</style>

<div class="admin-wrapper">

    <div class="text-center mb-10">
        <a href="<%= typeof adminPath !== 'undefined' ? adminPath : '/admin' %>/dashboard" class="back-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Discard Changes
        </a>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
            Update <span class="text-blue-500">Anime</span>
        </h1>
        <p class="text-gray-500 mt-2 font-medium">Editing Metadata for: <span class="text-white font-bold"><%= anime.name %></span></p>
    </div>

    <%- include('partials/flash') %>

    <div class="ui-card">
        <form action="<%= typeof adminPath !== 'undefined' ? adminPath : '/admin' %>/edit-anime/<%= anime._id %>" method="POST" id="editAnimeForm">

            <div class="mb-8">
                <label class="ui-label">Content Type</label>
                <div class="type-selector">
                    <label class="type-option <%= anime.type === 'series' || !anime.type ? 'active' : '' %>" id="type-series">
                        <input type="radio" name="type" value="series" <%= anime.type === 'series' || !anime.type ? 'checked' : '' %>>
                        <div class="type-icon">📺</div>
                        <div class="type-label">TV Series</div>
                        <div class="type-desc">Multiple episodes & seasons</div>
                    </label>
                    <label class="type-option <%= anime.type === 'movie' ? 'active' : '' %>" id="type-movie">
                        <input type="radio" name="type" value="movie" <%= anime.type === 'movie' ? 'checked' : '' %>>
                        <div class="type-icon">🎬</div>
                        <div class="type-label">Movie</div>
                        <div class="type-desc">Single video file</div>
                    </label>
                </div>
            </div>

            <% if(anime.type === 'series' && anime.seasons && anime.seasons.length > 0) { %>
            <div class="warning-box" id="type-warning" style="display: none;">
                <div class="warning-text">
                    ⚠️ WARNING: Changing Series to Movie will keep all episodes as S1E1.<br>
                    Existing episodes won't be deleted but season structure will be ignored.
                </div>
            </div>
            <% } %>

            <div class="mb-8">
                <label class="ui-label">Anime Title</label>
                <input type="text" name="name" value="<%= anime.name %>" class="ui-input" required maxlength="200">
            </div>

            <div class="mb-8">
                <label class="ui-label">Cover Image URL</label>
                <input type="text" name="imageUrl" value="<%= anime.imageUrl %>" class="ui-input" required maxlength="500">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                    <label class="ui-label">AniList ID (Season 1) <span class="text-gray-500 text-xs font-normal ml-2">(Optional)</span></label>
                    <input type="number" name="anilistId" value="<%= anime.anilistId || '' %>" class="ui-input" placeholder="e.g. 151807" min="1">
                </div>
                <div>
                    <label class="ui-label">TMDB ID <span class="text-gray-500 text-xs font-normal ml-2">(Optional)</span></label>
                    <input type="number" name="tmdbId" value="<%= anime.tmdbId || '' %>" class="ui-input" placeholder="e.g. 1357633" min="1">
                </div>
            </div>

            <!-- Per-Season AniList IDs -->
            <div class="mb-8 p-5 rounded-2xl bg-black/20 border border-white/10" id="seasonIdsSection">
                <div class="flex items-center justify-between mb-4">
                    <label class="ui-label mb-0">Season AniList IDs <span class="text-gray-500 text-xs font-normal ml-2">(Per-Season Sync Mapping)</span></label>
                    <button type="button" id="addSeasonRowBtn" class="px-3 py-1.5 rounded-lg bg-blue-600/20 text-blue-400 border border-blue-500/30 text-xs font-bold uppercase hover:bg-blue-600 hover:text-white transition-all">
                        + Add Season
                    </button>
                </div>
                <div id="seasonRowsContainer" class="space-y-3">
                    <% if (anime.seasons && anime.seasons.length > 0) { %>
                        <% anime.seasons.forEach(season => { %>
                            <div class="grid grid-cols-12 gap-3 items-center season-row">
                                <div class="col-span-4">
                                    <input type="number" name="seasonNumbers[]" value="<%= season.seasonNumber %>" min="1" class="ui-input" readonly>
                                </div>
                                <div class="col-span-8">
                                    <input type="number" name="seasonAnilistIds[]" value="<%= season.anilistId || '' %>" min="1" class="ui-input" placeholder="Season <%= season.seasonNumber %> AniList ID">
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="grid grid-cols-12 gap-3 items-center season-row">
                            <div class="col-span-4">
                                <input type="number" name="seasonNumbers[]" value="2" min="2" class="ui-input" placeholder="Season #">
                            </div>
                            <div class="col-span-7">
                                <input type="number" name="seasonAnilistIds[]" min="1" class="ui-input" placeholder="Season 2 AniList ID (Optional)">
                            </div>
                            <div class="col-span-1 text-right">
                                <button type="button" class="remove-season-btn text-red-400 hover:text-red-300 font-bold text-lg px-2">&times;</button>
                            </div>
                        </div>
                    <% } %>
                </div>
                <p class="text-[10px] text-gray-500 mt-3 uppercase tracking-wider">Existing seasons are locked to protect episodes. Update their AniList IDs or add a new season.</p>
            </div>

            <div class="mb-8">
                <label class="ui-label">Language / Format <span class="text-gray-500 text-xs font-normal ml-2">(Optional)</span></label>
                <input type="text" name="languageFormat" value="<%= anime.languageFormat || '' %>" class="ui-input" placeholder="e.g. Sub | Dub | English" maxlength="50">
            </div>

            <div class="mb-8">
                <label class="ui-label">Synopsis / Description</label>
                <textarea name="description" rows="5" class="ui-input" required maxlength="5000"><%= anime.description %></textarea>
            </div>

            <div class="mb-10">
                <label class="ui-label">Categories / Genres</label>
                <div class="genre-grid">
                    <% if (typeof genres !== 'undefined' && genres && genres.length > 0) { %>
                        <% genres.forEach(genre => { %>
                            <label class="genre-item">
                                <input type="checkbox" name="genres" value="<%= genre._id %>"
                                    <%= anime.genres.some(g => g._id.toString() === genre._id.toString()) ? 'checked' : '' %>>
                                <%= genre.name %>
                            </label>
                        <% }) %>
                    <% } else { %>
                        <p class="text-gray-500 text-sm col-span-full text-center">No genres available. Add some in Manage Categories.</p>
                    <% } %>
                </div>
                <div class="form-error" id="genreError">⚠️ Please select at least one genre before saving.</div>
            </div>

            <div class="mb-8">
                <label class="ui-label">Special Information / Announcements</label>
                <textarea name="specialInfo" rows="3" class="ui-input" placeholder="e.g. MORE EPISODE WILL BE ADDED AFTER RELEASE..." maxlength="500"><%= anime.specialInfo || '' %></textarea>
                <p class="text-[10px] text-gray-500 mt-2 italic">Note: This will only appear on the anime page if you write something here.</p>
            </div>

            <button type="submit" class="ui-button" id="submitBtn">
                Save Changes
            </button>
        </form>
    </div>
</div>

<script>
    // 1. Type selector toggle
    const typeOptions = document.querySelectorAll('.type-option');
    const warningBox = document.getElementById('type-warning');
    const currentType = '<%= anime.type || "series" %>';

    typeOptions.forEach(option => {
        option.addEventListener('click', () => {
            typeOptions.forEach(opt => opt.classList.remove('active'));
            option.classList.add('active');
            option.querySelector('input').checked = true;

            if (warningBox) {
                const newType = option.querySelector('input').value;
                warningBox.style.display = (currentType === 'series' && newType === 'movie') ? 'block' : 'none';
            }
        });
    });

    // 2. Form Validation: Enforce at least 1 genre selected
    const form = document.getElementById('editAnimeForm');
    const checkboxes = document.querySelectorAll('input[name="genres"]');
    const genreError = document.getElementById('genreError');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', function(e) {
        if (checkboxes.length > 0) {
            let isChecked = false;
            for (let i = 0; i < checkboxes.length; i++) {
                if (checkboxes[i].checked) {
                    isChecked = true;
                    break;
                }
            }

            if (!isChecked) {
                e.preventDefault();
                genreError.classList.add('show');
                genreError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
        }

        genreError.classList.remove('show');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
    });

    checkboxes.forEach(box => {
        box.addEventListener('change', () => {
            if (box.checked) {
                genreError.classList.remove('show');
            }
        });
    });

    // 3. Manage Per-Season AniList IDs
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('seasonRowsContainer');
        const addBtn = document.getElementById('addSeasonRowBtn');

        if (addBtn && container) {
            addBtn.addEventListener('click', () => {
                const nums = Array.from(container.querySelectorAll('input[name="seasonNumbers[]"]'))
                    .map(el => Number(el.value) || 1);
                const nextSeason = nums.length ? Math.max(...nums) + 1 : 2;

                const row = document.createElement('div');
                row.className = 'grid grid-cols-12 gap-3 items-center season-row';
                row.innerHTML = `
                    <div class="col-span-4">
                        <input type="number" name="seasonNumbers[]" value="${nextSeason}" min="2" class="ui-input" placeholder="Season #">
                    </div>
                    <div class="col-span-7">
                        <input type="number" name="seasonAnilistIds[]" min="1" class="ui-input" placeholder="Season ${nextSeason} AniList ID (Optional)">
                    </div>
                    <div class="col-span-1 text-right">
                        <button type="button" class="remove-season-btn text-red-400 hover:text-red-300 font-bold text-lg px-2">&times;</button>
                    </div>
                `;
                container.appendChild(row);
            });

            container.addEventListener('click', (e) => {
                if (e.target.classList.contains('remove-season-btn')) {
                    e.target.closest('.season-row').remove();
                }
            });
        }
    });
</script>

<%- include('partials/footer') %>